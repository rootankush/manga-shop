<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/style.css">
    <title>Document</title>
  </head>
  <body>
    <%- include('../../views/partials/header.ejs') %>
    <h1 class="pageHeading">Series</h1>
    <div class="seriesMain">
      <% for(const serie of series) { %>
        <li class="seriesList">
        <h2>
          <%= serie.title %>
        </h2>
        <h3>
          <%= serie.description %>
        </h3>
        <h3>
          <%= serie.category_name %>
        </h3>
        <h3>
          <%= serie.publisher_name %>
        </h3>
          <a class="cardBtn" href="/series/<%= serie.id %>">Detail</a>
          <a class="cardBtn">Delete</a>
      </li>
     <% } %> 
    </div>
    <%- include('../../views/partials/footer.ejs') %>
  </body>
</html>
